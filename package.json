{
  "name": "lacasa",
  "private": true,
  "version": "0.0.0",
  "description": "La Casa — real-estate CRM monorepo (web console, REST API, crosspost extension, mobile app)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react-native": {
      "react": "19.2.3"
    }
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.27.7": true,
    "@parcel/watcher@2.6.0": false,
    "@dynamicss/dynamicss@2.2.8": false,
    "msw@2.15.0": false
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @lacasa/web",
    "dev:api": "npm run dev -w @lacasa/api",
    "dev:console": "npm run dev -w @lacasa/console",
    "dev:mobile-flutter": "cd apps/mobile_flutter && flutter run"
  }
}
