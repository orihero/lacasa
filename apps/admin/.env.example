# La Casa control room — the whole environment surface of this app.
#
# Only VITE_* variables exist here, and that is a rule rather than an accident:
# anything Vite exposes under that prefix is inlined into the built bundle and
# shipped to every browser that loads the app. NO CREDENTIAL MAY EVER LIVE IN
# THIS FILE. The admin API is protected by the session token the server issues
# at sign-in and by requireRole("ADMIN") on every /api/admin route — not by
# anything configured here.

# The API this tab talks to. Also the value the environment strip derives its
# name and target from (src/shell — see specs/shell.md §7), which is why it is
# read synchronously from the bundle rather than asked of the API: a strip that
# says the wrong thing for 200ms is worse than one derived from the same
# variable the requests themselves are built from.
VITE_API_URL=http://localhost:4200/api

# Optional operator labels for that strip. VITE_ENV_NAME replaces the derived
# "Local"/"Remote"; VITE_DB_LABEL replaces the derived hostname. Neither can
# make a remote database render as safe — the danger tone is derived from the
# hostname, and a hostname cannot lie about where the bytes are going.
# VITE_ENV_NAME=Staging
# VITE_DB_LABEL=lacasa-staging
