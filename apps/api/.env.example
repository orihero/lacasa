# Copy to apps/api/.env for local development. Never commit apps/api/.env.

DATABASE_URL=postgresql://lacasa:lacasa_dev@localhost:5432/lacasa
PORT=4200
# Comma-separated list of allowed origins; unset allows all
CORS_ORIGIN=http://localhost:5273
# Used to build redirect URLs, e.g. the Instagram OAuth settings-page landing
APP_URL=http://localhost:5273
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# MinIO — docker-compose values shown; a native scoop MinIO uses minioadmin/minioadmin by default
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=lacasa
MINIO_SECRET_KEY=lacasa_dev_secret
MINIO_BUCKET=lacasa
# Base URL clients use to load objects (public-read bucket); defaults to http://localhost:9000/<MINIO_BUCKET>
MINIO_PUBLIC_URL=http://localhost:9000/lacasa
# Instagram OAuth (Business Login for Instagram) — leave unset to disable /api/auth/instagram/*
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:4200/api/auth/instagram/callback
# Unset disables extension-assisted AI field-mapping (docs/07 §3.3)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# Per-agent daily cap on OLX cross-post sessions (docs/07 §7)
OLX_DAILY_CAP=15
IG_ASSIST_DAILY_CAP=5
# Server-side Telegram publish + contact relay (rotate the old leaked tokens before use). Left optional like IG_APP_ID/ANTHROPIC_API_KEY: unset degrades /api/publish/telegram and /api/contact to a clean 503 (TG_CONFIGURED below), it does not fail boot -- flipping this to required would break every dev machine and CI job that has never set it.
TG_BOT_TOKEN=
# Office chat POST /api/contact relays to; unset also degrades that route to a 503, same reasoning as TG_BOT_TOKEN
TG_CONTACT_CHAT_ID=
# Firebase Cloud Messaging legacy server key for push notifications (pushService.js). Optional like TG_BOT_TOKEN/ANTHROPIC_API_KEY: unset degrades every push send to a logged no-op (PUSH_CONFIGURED below) instead of failing boot or failing whatever write (a lead, a publish outcome) triggered the push attempt -- see lib/activity.js and publishService.js for those trigger points. There is deliberately no client wired up to register a device yet (docs/09's mobile-app slice keeps permission_gateway.dart's short-circuit in place until this exists end-to-end); this var only gates the server's half.
FCM_SERVER_KEY=
# IANA zone that defines what 'today'/'thisWeek'/'thisMonth' mean for GET /api/statistics/ads and .../ads/series (statisticsService.js#dateRangeFor). This is a single-market product -- phone numbers are validated ^+998\d{9}$ and the region vocabulary is Uzbekistan's 14 regions/203 districts -- so 'today' means today in Uzbekistan, not wherever the API process happens to be deployed. Uzbekistan has run UTC+5 year-round with no DST since 1992, so one fixed zone answers correctly for every agent. A second market would break that assumption (either a second DST-observing zone, or just a second UTC offset) and would need a per-agent/per-request zone resolved from the agent's region, not one process-wide default.
STATISTICS_TIMEZONE=Asia/Tashkent
