# apps/web's entire client-side env surface (grep-verified — see
# apps/web/src/services/yt.ts and apps/web/src/lib/httpTransport.js for the
# only `import.meta.env.*` reads left in this app).
#
# VITE_TG_BOT_TOKEN and friends used to live here too: a live Telegram bot
# token, compiled straight into the public JS bundle
# (docs/05-migration-plan.md Phase E). Telegram publishing now goes through
# the server's own stored token (POST /api/publish/telegram, POST
# /api/contact — see apps/api/.env.example's TG_BOT_TOKEN/
# TG_CONTACT_CHAT_ID), so no Telegram credential belongs in this file, or in
# any VITE_* var, ever again.
VITE_API_URL=http://localhost:4200/api

# YouTube uploads stay client-side (the user's own OAuth token) — this is
# not part of the Telegram-token leak fixed above.
VITE_YT_TOKEN=
VITE_YT_CLIEND_ID=
