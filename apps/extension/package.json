{
  "name": "@lacasa/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "La Casa cross-poster — autofills OLX.uz and Instagram from a La Casa listing; you review and publish.",
  "scripts": {
    "build": "node build.mjs",
