# Copy to server/.env for local development. Never commit server/.env.

DATABASE_URL=postgresql://lacasa:lacasa_dev@localhost:5432/lacasa

PORT=4200
CORS_ORIGIN=http://localhost:5273
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MinIO — docker-compose values shown; a native scoop MinIO uses
# minioadmin/minioadmin by default
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=lacasa
MINIO_SECRET_KEY=lacasa_dev_secret
MINIO_BUCKET=lacasa
# Base URL clients use to load objects (public-read bucket)
MINIO_PUBLIC_URL=http://localhost:9000/lacasa

# Social publishing (server-held; rotate the old leaked tokens before use)
TG_BOT_TOKEN=
TG_CONTACT_CHAT_ID=
